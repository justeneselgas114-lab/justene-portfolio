# Resend — required for contact form
# Sign up: https://resend.com
RESEND_API_KEY=re_xxx
# Verified sender (defaults to onboarding@resend.dev for testing)
RESEND_FROM=hello@yourdomain.com

# Anthropic — required for the AI assistant chat widget
# Get a key: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxx

# CallMeBot — sends WhatsApp notifications when someone submits the contact form
# Setup (free, ~2 min):
#   1. Save +34 644 51 95 23 as "CallMeBot" in your phone
#   2. Send: "I allow callmebot to send me messages"
#   3. You'll receive an API key by reply
#   4. Set CALLMEBOT_PHONE to your number (international, NO + or spaces) and CALLMEBOT_API_KEY to the key
CALLMEBOT_API_KEY=
CALLMEBOT_PHONE=639638296973

# Site URL — used in sitemap + OG metadata
NEXT_PUBLIC_SITE_URL=https://justene.dev
